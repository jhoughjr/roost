#!/usr/bin/env bash
# roost — one command for the whole platform.
#
#   roost new <name> [--static|--node|--swift|--board]   nothing → live app
#   roost route <subdomain>                      publish a tunnel route
#   roost fleet                                  refresh the fleet board json
#   roost stats                                  run configured board-stat collectors
#   roost tapo [--json|--watch|--discover]       read Tapo smart plugs (wall watts)
#   roost ha-scoop [--days N|--json|--entities]  copy HA hourly power stats into pulse
#   roost backup [--json|--run|--check]          backup service state, start or verify a run
#   roost status ["message"]                     push status site (fleet+history+ledger)
#   roost kick                                   run the status runner's hourly deploy now
#   roost rollout [--kick]                       pull roost+statusgen on every writer machine
#   roost prune [project] [--yes] [--deep] [--caches]   reclaim build artifacts (dry-run default)
#   roost apps                                   list deployed apps
#   roost ps [app]                               container status
#   roost logs <app> [-n N]                      tail app logs (default 200)
#   roost restart <app>                          restart an app
#   roost config <app> [KEY=VAL ...]             show or set app config
#   roost doctor                                 diagnose the setup
#   roost ui                                     full-screen terminal (console, monitor, config, docs, backups tabs)
set -euo pipefail
BIN="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=/dev/null
. "$BIN/roost-env.sh"
STATUS_SITE="${ROOST_STATUS_SITE:-$HOME/status-site}"

cmd="${1:-help}"; shift || true
case "$cmd" in
  new)    exec "$BIN/new-app.sh" "$@" ;;
  route)  exec "$BIN/publish-route.sh" "$@" ;;
  fleet)  exec "$BIN/fleet-board.py" "$@" ;;
  tapo)   exec "$BIN/tapo-poll.py" "$@" ;;
  ha-scoop) exec "$BIN/ha-scoop.py" "$@" ;;
  backup) exec "$BIN/backup-status.py" "$@" ;;
  stats)
    SGEN="${ROOST_STATUSGEN:-$HOME/repos/statusgen}"
    [ -d "$SGEN/bin/collect" ] || { echo "roost stats: statusgen not found at $SGEN (set ROOST_STATUSGEN)"; exit 1; }
    python3 "$SGEN/bin/collect/repo_stats.py" || echo "note: repo stats failed (non-fatal)"
    python3 "$SGEN/bin/collect/ci_status.py" || echo "note: ci status failed (non-fatal)"
    # After ci_status: that one owns each repo's ✓/✗ tile, this one adds the
    # build's cost (time + green rate + trend) beside it.
    python3 "$SGEN/bin/collect/ci_health.py" || echo "note: ci health failed (non-fatal)"
    python3 "$SGEN/bin/collect/swift_tests.py" || echo "note: swift-tests failed (non-fatal)"
    # After swift_tests: that one counts the test cases a source tree declares, and this one reads what a gate actually reported.
    # A repo configured for both lands here second, so the measured result replaces the inventory tile rather than the reverse.
    python3 "$SGEN/bin/collect/swift_test_report.py" || echo "note: swift-test-report failed (non-fatal)"
    python3 "$SGEN/bin/collect/ci_live.py" || echo "note: ci live failed (non-fatal)"
    python3 "$SGEN/bin/collect/shipped_week.py" || echo "note: shipped-week failed (non-fatal)"
    python3 "$SGEN/bin/collect/narrative.py" || echo "note: narrative failed (non-fatal)"
    python3 "$SGEN/bin/collect/api_consumption.py" || echo "note: api-consumption failed (non-fatal)"
    python3 "$SGEN/bin/collect/proposal_state.py" || echo "note: proposal-state failed (non-fatal)"
    # Also Clauffice-sourced: the wayfinder map's frontier, blocked chains, and fog.
    python3 "$SGEN/bin/collect/wayfinder.py" || echo "note: wayfinder failed (non-fatal)"
    python3 "$SGEN/bin/collect/builds.py" || echo "note: builds failed (non-fatal)"
    # The boundary seam: health flows hatchery to roost. The collector reads hatchery's
    # status route (ROOST_HATCHERY_URL) and skips itself when unconfigured.
    python3 "$SGEN/bin/collect/hatchery_stacks.py" || echo "note: hatchery stacks failed (non-fatal)"
    python3 "$SGEN/bin/collect/loc.py" || echo "note: loc failed (non-fatal)"
    # After repo_stats: it upserts the "Test results" section wholesale, and
    # test_detail re-applies the tile links onto it each push.
    python3 "$SGEN/bin/collect/test_detail.py" || echo "note: test-detail failed (non-fatal)"
    ;;
  prune)  exec "$BIN/roost-prune.py" "$@" ;;
  status) exec "$BIN/status.sh" "$@" ;;
  rollout) exec "$BIN/rollout.sh" "$@" ;;
  kick)
    # Fire the status runner's LaunchAgent now instead of waiting out the hour
    # (e.g. right after merging a site or board change on GitHub). No -k: never
    # kill a deploy already in flight — if one is running, that's the goal met.
    RUNNER="$ROOST_STATUS_RUNNER"
    AGENT="$ROOST_STATUS_AGENT"
    echo "kicking $AGENT on $RUNNER"
    exec ssh -o BatchMode=yes -o ConnectTimeout=8 "$RUNNER" "launchctl kickstart gui/\$(id -u)/$AGENT"
    ;;
  apps)   exec ssh -o BatchMode=yes "$DOKKU" apps:list ;;
  ps)     exec ssh -o BatchMode=yes "$DOKKU" ps:report "$@" ;;
  logs)
    app="${1:?usage: roost logs <app> [-n N]}"; shift || true
    n=200; [ "${1:-}" = "-n" ] && n="${2:-200}"
    exec ssh -o BatchMode=yes "$DOKKU" logs "$app" -n "$n"
    ;;
  restart) exec ssh -o BatchMode=yes "$DOKKU" ps:restart "${1:?usage: roost restart <app>}" ;;
  config)
    # Reads stay here. Writes moved to hatchery, which writes the declaration and lets
    # tofu apply, so the declaration stays true. A value set through dokku directly is
    # invisible to the declaration, and tofu plan starts describing something that is
    # no longer true — the drift hatchery config audit exists to find.
    app="${1:?usage: roost config <app> [--force KEY=VALUE ...]}"; shift || true
    if [ $# -eq 0 ]; then exec ssh -o BatchMode=yes "$DOKKU" config:show "$app"; fi
    if [ "${1:-}" = "--force" ]; then
      shift
      [ $# -gt 0 ] || { echo "usage: roost config $app --force KEY=VALUE ..." >&2; exit 64; }
      ssh -o BatchMode=yes "$DOKKU" config:set "$app" "$@"
      echo "note: the declaration did not see this write. Run: hatchery config audit" >&2
      exit 0
    fi
    {
      echo "roost does not write config any more. hatchery owns config, because it writes"
      echo "the declaration and the declaration must stay true."
      echo "  hatchery config set <stack> $app KEY=VALUE"
      echo "  roost config $app --force KEY=VALUE    # the old direct write, then audit it"
    } >&2
    exit 64
    ;;
  ui)     exec python3 "$BIN/roost-ui.py" "$@" ;;
  doctor)
    fail=0
    say() { printf "%-38s %s\n" "$1" "$2"; }
    # shellcheck disable=SC2088  # tilde is display text here, not a path
    if [ -f "$HOME/.roostrc" ]; then say "~/.roostrc" "✓ present"; else say "~/.roostrc" "– missing (using defaults; copy roostrc.example)"; fi

    if ssh -o BatchMode=yes -o ConnectTimeout=8 "$DOKKU" version > /dev/null 2>&1; then
      say "dokku ssh ($DOKKU)" "✓ ok"
    else
      say "dokku ssh ($DOKKU)" "✗ FAILED — key not added? (dokku ssh-keys:add)"; fail=1
    fi

    TOKEN="$(cat "$HOME/.cf_api_token" 2>/dev/null || true)"
    if [ -z "$TOKEN" ]; then
      say "cloudflare token" "✗ ~/.cf_api_token missing (see playbook §1)"; fail=1
    else
      verify=$(curl -s -m 10 -H "Authorization: Bearer $TOKEN" \
        https://api.cloudflare.com/client/v4/user/tokens/verify 2>/dev/null | grep -o '"status":"active"' || true)
      if [ -n "$verify" ]; then say "cloudflare token" "✓ active"; else say "cloudflare token" "✗ invalid/expired"; fail=1; fi
      zone=$(curl -s -m 10 -H "Authorization: Bearer $TOKEN" \
        "https://api.cloudflare.com/client/v4/zones?name=$DOMAIN" 2>/dev/null | grep -o '"name":"'"$DOMAIN"'"' || true)
      if [ -n "$zone" ]; then say "zone $DOMAIN" "✓ visible to token"; else say "zone $DOMAIN" "✗ not visible — token missing Zone/DNS scope?"; fail=1; fi
    fi

    if command -v gh > /dev/null && gh auth status > /dev/null 2>&1; then
      say "github cli" "✓ authed"
    else
      say "github cli" "– not authed (optional: repos, portfolio builds)"
    fi
    command -v swift > /dev/null && say "swift toolchain" "✓ $(swift --version 2>&1 | head -1 | cut -c1-40)" || say "swift toolchain" "– absent (only needed for --swift apps)"
    command -v node > /dev/null && say "node" "✓ $(node --version)" || say "node" "– absent (only needed to test node apps locally)"
    [ -d "$STATUS_SITE" ] && say "status site ($STATUS_SITE)" "✓ present" || say "status site ($STATUS_SITE)" "– missing (roost status unavailable)"

    if [ "$fail" -eq 0 ]; then echo; echo "✓ roost is healthy"; else echo; echo "✗ problems found — fix the ✗ lines above"; exit 1; fi
    ;;
  help)
    if [ -t 1 ]; then R=$'\033[31m' Y=$'\033[33m' B=$'\033[1m' D=$'\033[2m' X=$'\033[0m'; else R='' Y='' B='' D='' X=''; fi
    printf '%s\n' \
      "   ${R},,,${X}" \
      "   (o${Y}>${X}        ${B}r o o s t${X}" \
      "\\\\_//)        ${D}one command for the whole platform.${X}" \
      " \\_/_)" \
      "  _|_" \
      "═════════"
    echo
    sed -n '4,21p' "$0" | sed 's/^# \{0,1\}//'
    echo
    echo "  anything else dispatches to roost-<cmd> (PATH, then \$ROOST_STATUSGEN/bin)"
    ;;
  *)
    # Plugin dispatch (roost#14): an unrecognized command looks for
    # roost-$cmd on PATH first, then in statusgen's bin — so statusgen can
    # ship board-shaped commands itself and roost core can eventually stop
    # knowing its internals.
    SGEN="${ROOST_STATUSGEN:-$HOME/repos/statusgen}"
    if command -v "roost-$cmd" >/dev/null 2>&1; then
      exec "roost-$cmd" "$@"
    elif [ -x "$SGEN/bin/roost-$cmd" ]; then
      exec "$SGEN/bin/roost-$cmd" "$@"
    fi
    echo "roost: unknown command '$cmd' — run 'roost help' (plugins: roost-$cmd on PATH or in $SGEN/bin)" >&2
    exit 2
    ;;
esac
