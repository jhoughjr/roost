# Roost toolbelt config — copy to ~/.roostrc and fill in your values.
ROOST_DOKKU_HOST=dokku@YOUR_HOST_IP
ROOST_DOMAIN=yourdomain.net
# any always-on app; used to read host metrics via `dokku run`
ROOST_METRIC_APP=someapp
# your statusgen site checkout (for `roost status` / `roost fleet`)
ROOST_STATUS_SITE=$HOME/status-site
# board-stat collectors + history/renderer for `roost status` — optional
# ROOST_STATUSGEN=$HOME/repos/statusgen
# ROOST_DOCS=$HOME/repos/docs   # usage-report.py for the Claude usage ledger
# ROOST_CI_BOARD=someboard
# ROOST_CI_REPOS=owner/repo:Label:4,owner/other:Other:3
# ci-health — build COST beside the ✓/✗: build time, green rate, and a
# build-time trend chart, per repo, written into that repo's compare column.
# owner/repo:ColumnTitleMatch:branch:samples[:workflow]. Worth having wherever
# a pipeline compiles something: a caching win that halves the build is
# invisible in a green checkmark.
# ROOST_CI_HEALTH_BOARD=someboard
# ROOST_CI_HEALTH=owner/server:Server:dev:12
# swift-tests — a test INVENTORY tile (cases + files) counted from
# origin/<branch>, for a Swift repo whose suite does not run in CI and so has
# no report to read. Labelled "Tests written", never "green": nothing here
# observed a test pass. dir:ColumnTitleMatch:branch[:testsDir]
# ROOST_SWIFT_TESTS_BOARD=someboard
# ROOST_SWIFT_TESTS=$HOME/repos/server:Server:dev
# ci-live — a self-refreshing "CI — running now" console fed by the ci-live app.
# The static collector (ci_live.py) drops a live-console section on this board;
# it points the renderer at the endpoint below, per project slug. The interval
# is a first-load fallback only — the poller advertises the real cadence.
# ROOST_CI_LIVE_BOARD=someboard
# ROOST_CI_LIVE_URL=https://ci.jimmyhoughjr.net/api/runs
# ROOST_CI_LIVE_PROJECT=phoenix
# ROOST_CI_LIVE_INTERVAL=30
# ci-live poller (ci-live-report.sh, runs on the mini) — per-project repos it
# watches, owner/repo:project:intervalSec[:Label], and the app's base URL. Label
# is what the console prints; match it to the label in ROOST_CI_REPOS or the
# same repo gets two names depending on whether its run has finished.
# The shared POST key lives in ~/.roost_ci_key (chmod 600), matching
# `dokku config ci-live CI_KEY`.
# ROOST_CI_LIVE_REPOS=Austin-MacWorks/Phoenix-Electron:phoenix:30:Phoenix
# ROOST_CI_LIVE_ENDPOINT=https://ci.jimmyhoughjr.net
# One extra project carrying every repo's live runs merged, newest first. A
# live-console polls exactly ONE project, so a multi-repo board needs this to
# show more than one repo running — point ROOST_CI_LIVE_PROJECT at it. Use a
# name no per-repo project uses.
# ROOST_CI_LIVE_AGGREGATE=all
# ROOST_STATS_BOARD=someboard
# ROOST_STATS_REPO_DIR=$HOME/repos/yourapp
# ROOST_STATS_LABEL=YourApp
# ROOST_STATS_GH_REPO=owner/yourapp        # GitHub repo for CI stats + PR narrative
# ROOST_STATS_CI_BRANCH=dev                # branch whose CI run feeds the board
# narrative — `roost status` with no message composes one from merged PRs
# ROOST_NARRATIVE_SINCE_DAYS=7
# source freshness — extra repos `roost status` pulls before collecting
# ROOST_SOURCE_REPOS=$HOME/repos/statusgen:$HOME/repos/docs
# status runner — where `roost kick` fires the hourly deploy agent
# ROOST_STATUS_RUNNER=you@your-ci-mac.local
# ROOST_STATUS_AGENT=net.yourdomain.roost-status
# rollout — machines `roost rollout` pulls roost+statusgen on after a merge
# (space-separated ssh targets; defaults to ROOST_STATUS_RUNNER; set empty
# for a single-machine setup). ROOST_CLONE = where roost lives on THIS machine.
# ROOST_WRITERS=you@your-ci-mac.local
# ROOST_CLONE=$HOME/repos/roost
# roost prune — where your project repos live + extra artifact dir names
# ROOST_PROJECTS_DIR=$HOME/repos
# ROOST_PRUNE_EXTRA=coverage:.turbo

# fleet-board — apps whose root URL intentionally redirects; default expectation is 200
# ROOST_EXPECTED_HTTP=status:302,blog:301
# fleet-alert ntfy.sh phone notifications — optional; skip if unset
# ROOST_NTFY_TOPIC=roost-jimmy-12345678

# node-report (per-node telemetry → pulse /api/nodes; key in ~/.roost_node_key)
# macOS and Linux. Measured watts come from macmon (Apple silicon) or, on Linux,
# a Tapo plug via tapo-poll (below); idle/max are the fallback model only.
# ROOST_NODE_NAME=my-macbook               # default: ComputerName / hostname
# ROOST_NODE_IDLE_W=7                      # power model inputs when no measured
# ROOST_NODE_MAX_W=40                      #   source exists (Intel, bare Linux)

# tapo-poll — TP-Link Tapo devices over the local KLAP API (no cloud, no Matter
# controller, works on the Matter "M" models). Password in ~/.tapo_pass (600).
# Find IPs with `roost tapo --discover` — that needs no credentials.
# ROOST_TAPO_EMAIL=you@example.com
# ROOST_TAPO_DEVICES=opi=192.168.0.27,fridge=192.168.0.57,room=192.168.0.201
# ROOST_TAPO_FLEET=opi                     # plug powering this box → wattsW
# ROOST_TAPO_INTERVAL=30                   # --watch seconds (default 30)
# Bulbs can be listed too — they have no current sensor, so their watts are
# brightness × the rated draw below, flagged `derived` and never summed into
# a measured total. 8.7 W is the L530/L530E rating.
# ROOST_TAPO_BULB_W=8.7
# pulse base URL — `roost ui` monitor tab + node/fleet tooling
# ROOST_PULSE_URL=https://pulse.yourdomain.net

# loc collector — JSON config describing the LOC buckets a board charts.
# Lives with the board it describes (see status-site/<slug>/loc.config.json)
# so both writer machines get it by git pull. Unset = collector skips.
# ROOST_LOC_CONFIG=$HOME/status-site/clauffice/loc.config.json
